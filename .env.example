# AI 拟人系统 密钥配置示例
# 复制为 .env 并填入真实密钥；.env 已被 .gitignore 忽略，不会进入版本库。
# 各密钥由 server.py 的 _apply_env_overrides 在运行时注入配置，
# config.json 中无需（也不应）保存明文密钥。

# 文字模型：小米 MiMo（cloud.provider=mimo 时使用）
MIMO_API_KEY=

# 文字模型：深度求索 DeepSeek（cloud.provider=deepseek 时使用）
DEEPSEEK_API_KEY=

# 文字模型：火山方舟（cloud.provider=ark 时使用）
ARK_API_KEY=

# 语音合成：阿里云百炼 DashScope（voice.provider=aliyun 时使用）
ALIYUN_API_KEY=

# ALIYUN_API_KEY 的兼容别名（两者填其一即可，ALIYUN_API_KEY 优先）
DASHSCOPE_API_KEY=

# 语音合成：MiniMax 海螺（voice.provider=minimax 时使用）
MINIMAX_API_KEY=

# 语音合成：GMI Cloud MiniMax（voice.minimax.api_schema=gmi 时使用，活动免费模型）
GMI_API_KEY=

# 可选：MiniMax 计费模式兜底（payg 按量付费 | token_plan 订阅套餐；config 未配置时生效）
# MINIMAX_BILLING_MODE=payg

# 可选：日志级别（DEBUG/INFO/WARNING/ERROR，默认 WARNING）
# LOG_LEVEL=WARNING

# 可选：远程访问口令（通过 ngrok 隧道 / 局域网访问时生效）
# 与 config.json 顶层的 access_token 二选一，config.json 中的值优先。
# 未配置时不启用访问保护，仅本机可访问。
# ACCESS_TOKEN=
